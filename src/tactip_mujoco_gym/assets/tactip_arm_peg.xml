<mujoco model="z1 scene">
  <compiler angle="radian" meshdir="robotarm/assets"/>
<option integrator="implicit" timestep="0.001" tolerance="1e-6">
    <flag contact="enable" multiccd="enable"/>
</option>
<default>
    <default class="z1">
      <joint damping="1" frictionloss="1"/>
      <general biastype="affine" gainprm="1000" biasprm="0 -1000 -100" forcerange="-30 30"/>
      <default class="visual">
        <geom type="mesh" group="2" contype="0" conaffinity="0"/>
      </default>
      <default class="collision">
        <geom type="cylinder" group="3" mass="0" density="0"/>
      </default>
    </default>
    </default>

  <asset>
    <include file="robotarm/assets.xml"/>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" rgb1=".2 .3 .4" rgb2=".1 .2 .3" width="512" height="512"/>
        <material name="grid" texture="groundplane" reflectance=".2" texrepeat="5 5"/>
       <include file="sensor/asset.xml"/>
  </asset>
  <statistic center="0 0 0.1" extent="0.6"/>
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <worldbody>
   <geom name="floor" type="plane" size="0 0 1" pos="0 0 0" material="grid" condim="3" group="1" contype="1" conaffinity="1"/>
    <body name="robot">
        <include file="robotarm/worldbody.xml"/>
    </body>
    <!-- Platform with a 6x6 cm hole centred at (0.45, 0). Top surface at z=0.05 -->
<body name="platform" pos="0 0 0">
  <geom name="plat_left"  type="box" pos="0.45 -0.09 0.04" size="0.15 0.06 0.01" rgba="0.6 0.6 0.6 1" friction="0.8 0.005 0.0001"/>
  <geom name="plat_right" type="box" pos="0.45  0.09 0.04" size="0.15 0.06 0.01" rgba="0.6 0.6 0.6 1" friction="0.8 0.005 0.0001"/>
  <geom name="plat_near"  type="box" pos="0.36  0.00 0.04" size="0.06 0.03 0.01" rgba="0.6 0.6 0.6 1" friction="0.8 0.005 0.0001"/>
  <geom name="plat_far"   type="box" pos="0.54  0.00 0.04" size="0.06 0.03 0.01" rgba="0.6 0.6 0.6 1" friction="0.8 0.005 0.0001"/>
</body>

<!-- Cylinder: radius 2 cm, half-height 3 cm, starts resting on the platform -->
<body name="peg_cyl" pos="0.33 0 0.0801">
  <freejoint name="peg_free"/>
  <geom name="peg_cyl_geom" type="cylinder" size="0.02 0.03" mass="0.05"
        rgba="0.9 0.3 0.1 1" friction="0.6 0.005 0.0001" condim="3"/>
</body>

<!-- Invisible marker at the hole centre (handy for debugging / obs) -->
<site name="hole_center" pos="0.45 0 0.05" size="0.005" rgba="0 1 0 0.5"/>
  </worldbody>
<contact>
    <exclude body1="flexible_structure" body2="link06"/>
    <exclude body1="cylinder_mount" body2="link06"/>
</contact>
   <equality>
<include file="sensor/equality.xml"/>
 </equality>
  <deformable>
  <!-- <include file="sensor/deformable.xml"/> -->
  </deformable>

  <tendon>
  <include file="sensor/tendon.xml"/>
  </tendon>
  <actuator>
<include file="robotarm/actuator.xml"/>
  </actuator>

</mujoco>
